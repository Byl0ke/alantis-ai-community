# Local: copia a .env (no lo subas a GitHub).
# Proveedor local gratuito (necesitas Ollama ejecutándose).
ALANTIS_PROVIDER=ollama
ALANTIS_MODEL=llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434

# Para Internet: usa un proveedor compatible con OpenAI, y tu propia clave.
# ALANTIS_PROVIDER=openai
# ALANTIS_MODEL=gpt-4o-mini
# ALANTIS_API_URL=https://api.openai.com/v1
# ALANTIS_API_KEY=tu_clave_PRIVADA

# En un servidor público con HTTPS: true. En localhost: false.
ALANTIS_COOKIE_SECURE=false
ALANTIS_REGISTRATION_OPEN=true
ALANTIS_DAILY_LIMIT=20
ALANTIS_MAX_CHARS=4000

# Local: SQLite (data/alantis_public.db). Producción: Postgres persistente.
# DATABASE_URL=postgresql://usuario:clave@host:5432/base